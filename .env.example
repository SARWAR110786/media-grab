# MediaGrab web app configuration (copy to apps/web/.env.local or set in your host's environment).
# All values are optional; defaults shown.

# Largest file the download proxy will relay, in MB.
MEDIAGRAB_MAX_FILE_SIZE_MB=2048
# Upstream connect/idle timeout in milliseconds.
MEDIAGRAB_UPSTREAM_TIMEOUT_MS=20000
# Maximum redirects followed (each hop is re-validated).
MEDIAGRAB_MAX_REDIRECTS=5
# Simultaneous proxied connections per client IP (each download segment counts as one).
MEDIAGRAB_MAX_CONCURRENT_PER_IP=24
# /api/analyze requests per client IP per minute.
MEDIAGRAB_ANALYZE_PER_MINUTE=60
# Number of reverse proxies in front of the app that append to X-Forwarded-For (used to find the
# real client address for rate limits). 1 fits nginx, Caddy, Vercel and most hosts.
MEDIAGRAB_TRUSTED_PROXY_HOPS=1
# Ports the server may connect to.
MEDIAGRAB_ALLOWED_PORTS=80,443

# DANGER: disables SSRF protection for loopback/private networks. Only for local testing against
# a fixture server. Never set this in production.
MEDIAGRAB_ALLOW_PRIVATE_HOSTS=false

# Set to "standalone" to produce a self-contained server build (used by the Dockerfile).
# NEXT_OUTPUT=standalone
